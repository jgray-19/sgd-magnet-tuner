-- MAD-NG bug report: sequence:replace() shifts element s-position
--
-- After replacing a monitor with a same-named marker via sequence:replace(),
-- the new element's s-position reported by siter() differs from the original.
-- Expected: s-position is preserved. Observed: position shifts.

local SEQ_FILE  = "lhcb1.seq"
local SEQ_NAME  = "lhcb1"
local TARGET    = "BPM.13R5.B1"   -- a monitor with zero length
local MRK_NAME  = "BPM.13R5.B1"   -- replace with a same-named marker

-- Load the MAD-X sequence
MADX:load(SEQ_FILE, SEQ_FILE:gsub("%.seq$", ".mad"), {rbarc=false})
local seq = MADX[SEQ_NAME]

-- Step 1: find target element using siter, record kind and s
local before_s, before_kind
for i, elm, s, ds in seq:siter() do
    if elm.name == TARGET then
        before_s    = s
        before_kind = elm.kind
        break
    end
end

if not before_s then
    error("Element '" .. TARGET .. "' not found in sequence")
end

-- Step 2: replace the monitor with a same-named marker
local correct_elm = MADX[TARGET]
local new_elm = MAD.element.marker(MRK_NAME) { at=correct_elm.at, from=correct_elm.from }
local replaced = seq:replace({new_elm}, TARGET)
-- MADX[MRK_NAME] = new_elm

-- Step 3: find the new marker using siter, record kind and s
local after_s, after_kind
for i, elm, s, ds in seq:siter() do
    if elm.name == MRK_NAME then
        after_s    = s
        after_kind = elm.kind
        break
    end
end

-- Step 4: report
print(string.format("\nElement : %s", TARGET))
print(string.format("  BEFORE replace -> kind=%-12s  s=%.15e", before_kind, before_s))
print(string.format("  AFTER  replace -> kind=%-12s  s=%.15e", after_kind,  after_s))
print(string.format("  delta s        = %.6e  (expected 0)", after_s - before_s))
if after_s ~= before_s then
    print("\n[BUG] s-position changed after sequence:replace() with a same-named marker!")
else
    print("\n[OK] s-position unchanged.")
end
